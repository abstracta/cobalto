$! CBLT_BUILD.COM - generated by CBLT (vms-vsi-cobol profile).
$! Compiles the core, the suites and the programs under test, and links CBLTDRV.EXE.
$! The compile command comes from compile_each in the profile and is written
$! straight into each line (an intermediate symbol does not work: DCL substitutes
$! the verb only once). The sources are in terminal format, which is what COBOL
$! reads without /ANSI_FORMAT; for a command with /ANSI_FORMAT, set
$! "source_format": "ansi" and "pad80": true in the profile.
$! If the compile command is asynchronous (SPAWN/NOWAIT, or SUBMIT to a batch
$! queue), the script waits before the LINK until no subprocesses are left and
$! every .OBJ exists, for up to 10 minutes. With SUBMIT the subprocess count does
$! not change: the signal that counts is the .OBJ files appearing. Old .OBJ files
$! are deleted before compiling so that a failed compile does not go unnoticed.
$ ON ERROR THEN GOTO FAIL
$ OBJS = "{objs}"
$ PRC0 = F$GETJPI("", "PRCCNT")
$ OBJ_MODE = "CLEAN"
$ GOSUB SCAN_OBJS
$ SET VERIFY
{compile_each}
$ SET NOVERIFY
$ SECS = 0
$ WAIT_OBJS:
$ OBJ_MODE = "COUNT"
$ GOSUB SCAN_OBJS
$ IF MISSING .EQ. 0 .AND. F$GETJPI("", "PRCCNT") .LE. PRC0 THEN GOTO OBJS_READY
$ IF SECS .GE. 600 THEN GOTO OBJS_MISSING
$ WAIT 00:00:02
$ SECS = SECS + 2
$ GOTO WAIT_OBJS
$ OBJS_READY:
$ IF SECS .GT. 0 THEN WRITE SYS$OUTPUT "CBLT: asynchronous compile, waited ''SECS' seconds"
$ IF SECS .GT. 0 THEN WAIT 00:00:02
$ SET VERIFY
$ LINK/EXE=CBLTDRV.EXE {objs}
$ SET NOVERIFY
$ WRITE SYS$OUTPUT "CBLT-BUILD-OK"
$ EXIT 1
$ OBJS_MISSING:
$ OBJ_MODE = "LIST"
$ GOSUB SCAN_OBJS
$ FAIL:
$ SET NOVERIFY
$ WRITE SYS$OUTPUT "CBLT-BUILD-FAILED"
$ EXIT 2
$!
$! Walks the OBJS list according to OBJ_MODE: CLEAN (deletes the ones that
$! exist), COUNT (leaves in MISSING how many do not exist) or LIST (writes
$! which ones do not exist).
$ SCAN_OBJS:
$ MISSING = 0
$ I = 0
$ SCAN_LOOP:
$ OBJ = F$EDIT(F$ELEMENT(I, ",", OBJS), "TRIM")
$ IF OBJ .EQS. "," THEN RETURN
$ I = I + 1
$ IF OBJ_MODE .EQS. "CLEAN" .AND. F$SEARCH(OBJ) .NES. "" THEN DELETE/NOLOG 'OBJ';*
$ IF F$SEARCH(OBJ) .EQS. "" THEN MISSING = MISSING + 1
$ IF OBJ_MODE .EQS. "LIST" .AND. F$SEARCH(OBJ) .EQS. "" THEN WRITE SYS$OUTPUT "CBLT: ''OBJ' was not generated"
$ GOTO SCAN_LOOP
