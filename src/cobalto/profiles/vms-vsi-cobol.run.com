$! CBLT_RUN.COM - generated by CBLT (vms-vsi-cobol profile).
$! Defines the logical name of the results file and runs the driver.
$ ON ERROR THEN GOTO FAIL
$ IF F$SEARCH("CBLT_RESULTS.DAT") .NES. "" THEN DELETE/NOLOG CBLT_RESULTS.DAT;*
$ DEFINE/USER_MODE CBLT_RESULTS CBLT_RESULTS.DAT
$ RUN CBLTDRV.EXE
$ WRITE SYS$OUTPUT "CBLT-RUN-OK"
$ EXIT 1
$ FAIL:
$ WRITE SYS$OUTPUT "CBLT-RUN-FAILED"
$ EXIT 2
