{
  "description": "GnuCOBOL with gcov: coverage by COBOL line. Verified.",
  "results_org": "LINE SEQUENTIAL",
  "results_format": "lines",
  "results_path": "build/cblt-results.txt",
  "compile": "cd {build} && cobc -x -g -fsource-location -ftraceall -Q --coverage -A --coverage -save-temps -std=default -I {lib_rel} {incl_rel} -o ../{exe} ../{driver} {lib_rel}/CBLTLIB.cbl {tests_rel} {sources_rel}",
  "run": "{exe}",
  "post": "cd {build} && gcov *.c >/dev/null 2>&1",
  "pre": "rm -f {build}/*.gcda {build}/*.gcov",
  "coverage_glob": "{build}/*cbl.gcov"
}
