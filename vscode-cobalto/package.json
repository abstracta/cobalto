{
  "name": "vscode-cobalto",
  "displayName": "Cobalto",
  "description": "Unit testing for COBOL with Cobalto: Test Explorer, coverage in the gutter, debugging in COBOL terms and syntax highlighting for the .cblt DSL",
  "version": "0.1.3",
  "publisher": "abstracta",
  "repository": {
    "type": "git",
    "url": "https://github.com/abstracta/cobalto.git",
    "directory": "vscode-cobalto"
  },
  "bugs": {
    "url": "https://github.com/abstracta/cobalto/issues"
  },
  "homepage": "https://github.com/abstracta/cobalto#readme",
  "license": "Apache-2.0",
  "icon": "icon.png",
  "galleryBanner": {
    "color": "#1B2A48",
    "theme": "dark"
  },
  "private": true,
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Testing",
    "Debuggers",
    "Programming Languages"
  ],
  "keywords": [
    "cobol",
    "gnucobol",
    "unit testing",
    "cobalto",
    "cblt",
    "testing",
    "coverage",
    "debugger",
    "mainframe"
  ],
  "activationEvents": [
    "workspaceContains:**/cblt.json",
    "onDebugResolve:cobalto",
    "onLanguage:cobalto-test"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "cobalto-test",
        "aliases": [
          "Cobalto test (.cblt)",
          "cobalto-test"
        ],
        "extensions": [
          ".cblt"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "cobalto-test",
        "scopeName": "source.cobalto-test",
        "path": "./syntaxes/cblt.tmLanguage.json"
      }
    ],
    "breakpoints": [
      {
        "language": "cobalto-test"
      }
    ],
    "debuggers": [
      {
        "type": "cobalto",
        "label": "Cobalto (GnuCOBOL with lldb-dap)",
        "languages": [
          "cobalto-test"
        ],
        "configurationAttributes": {
          "launch": {
            "properties": {
              "suite": {
                "type": "string",
                "description": "Suite to debug (the TESTSUITE identifier, for example TSTINV). 'cobalto debug --suite' runs before launching."
              },
              "program": {
                "type": "string",
                "description": "Executable generated by cobalto debug. Default: <project>/build/cbltdrv.",
                "default": "${workspaceFolder}/build/cbltdrv"
              },
              "cwd": {
                "type": "string",
                "description": "Project folder (the one that contains cblt.json).",
                "default": "${workspaceFolder}"
              },
              "prepare": {
                "type": "boolean",
                "description": "Run 'cobalto debug --suite' before launching (compiles with -g and regenerates the maps).",
                "default": true
              },
              "stopOnEntry": {
                "type": "boolean",
                "default": false
              },
              "lldbDapPath": {
                "type": "string",
                "description": "Path to lldb-dap. If missing: cobalto.lldbDapPath, lldb-dap.executable-path, 'xcrun -f lldb-dap' or the PATH."
              },
              "initCommands": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Additional lldb commands to run when the target is created."
              },
              "env": {
                "type": "object",
                "description": "Environment variables for the executable."
              },
              "formatValues": {
                "type": "boolean",
                "description": "Show COBOL fields with the value formatted by libcob (one evaluation per field). If false, the bytes are shown.",
                "default": true
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "cobalto",
            "request": "launch",
            "name": "Cobalto: debug suite",
            "suite": "${command:cobalto.pickSuite}",
            "cwd": "${workspaceFolder}"
          }
        ],
        "configurationSnippets": [
          {
            "label": "Cobalto: debug a suite",
            "description": "Compiles the suite with -g (cobalto debug) and debugs it with lldb-dap, showing COBOL names",
            "body": {
              "type": "cobalto",
              "request": "launch",
              "name": "Cobalto: debug ${1:TSTINV}",
              "suite": "${1:TSTINV}",
              "cwd": "^\"\\${workspaceFolder}\""
            }
          }
        ],
        "variables": {
          "pickSuite": "cobalto.pickSuite"
        }
      }
    ],
    "commands": [
      {
        "command": "cobalto.debugSuite",
        "title": "Debug suite",
        "category": "Cobalto"
      },
      {
        "command": "cobalto.runTests",
        "title": "Run the suites (cobalto test --coverage)",
        "category": "Cobalto"
      },
      {
        "command": "cobalto.refreshTests",
        "title": "Reload the suites",
        "category": "Cobalto"
      },
      {
        "command": "cobalto.toggleCoverage",
        "title": "Show or hide coverage in the gutter",
        "category": "Cobalto"
      },
      {
        "command": "cobalto.pickProfile",
        "title": "Choose the compiler (cblt.json profile)",
        "category": "Cobalto"
      },
      {
        "command": "cobalto.pickSuite",
        "title": "Choose a suite",
        "category": "Cobalto"
      }
    ],
    "configuration": {
      "title": "Cobalto",
      "properties": {
        "cobalto.profile": {
          "type": "string",
          "default": "",
          "description": "cblt.json profile used to run the suites from the Test Explorer (cobalto test --profile). Empty: the project's default profile. Choose it with the command \"Cobalto: Choose the compiler\" or from the status bar."
        },
        "cobalto.cliPath": {
          "type": "string",
          "default": "",
          "description": "Path to the cobalto executable (relative paths start at the project folder). Empty: a .venv in the project folder or in one above it, then the PATH."
        },
        "cobalto.lldbDapPath": {
          "type": "string",
          "default": "",
          "description": "Path to lldb-dap. Empty: lldb-dap.executable-path, then 'xcrun -f lldb-dap', then the PATH."
        },
        "cobalto.debug.adapterMode": {
          "type": "string",
          "enum": [
            "inline",
            "process"
          ],
          "default": "inline",
          "description": "How the DAP proxy runs: inside the extension host (inline) or as a separate process (process, the same binary used to verify over stdio)."
        },
        "cobalto.debug.formatValues": {
          "type": "boolean",
          "default": true,
          "description": "Show each COBOL field with the value formatted by libcob in the variables panel."
        },
        "cobalto.debug.maxFormattedFields": {
          "type": "number",
          "default": 200,
          "description": "If a scope has more fields than this number, they are shown as unformatted bytes."
        },
        "cobalto.coverage.showOnStart": {
          "type": "boolean",
          "default": false,
          "description": "Show coverage in the gutter when a Cobalto project is opened."
        },
        "cobalto.coverage.margin": {
          "type": "string",
          "enum": [
            "auto",
            "cobalto",
            "entriesOnly",
            "off"
          ],
          "default": "auto",
          "enumDescriptions": [
            "Everything, unless Coverage Gutters is installed: then only the entry counts per paragraph and the status bar.",
            "Executed and non-executed lines, entry counts per paragraph and the status bar.",
            "Only the entry counts per paragraph and the status bar; line highlighting is left to another extension (Coverage Gutters).",
            "Nothing in the gutter."
          ],
          "description": "What Cobalto draws in the gutter from build/lcov.info."
        },
        "cobalto.coverage.colors.covered": {
          "type": "string",
          "default": "rgba(166, 220, 142, 0.45)",
          "description": "Background color of executed statements (CSS)."
        },
        "cobalto.coverage.colors.uncovered": {
          "type": "string",
          "default": "rgba(255, 88, 88, 0.45)",
          "description": "Background color of non-executed statements (CSS)."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run lint && npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src",
    "test": "npm run compile && node --test \"out/test/unit/*.test.js\"",
    "package": "vsce package --no-dependencies",
    "verify:dap": "node ./out/test/verify-dap.js",
    "verify:layout": "node ./out/test/verify-layout.js",
    "verify:vscode": "node ./out/test/run-in-vscode.js"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "@types/vscode": "^1.100.0",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.6.0",
    "eslint": "^10.15.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.73.0"
  }
}
