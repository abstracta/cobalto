{
  "comments": {
    "lineComment": "*>"
  },
  "brackets": [["(", ")"]],
  "autoClosingPairs": [
    { "open": "(", "close": ")" },
    { "open": "\"", "close": "\"", "notIn": ["string", "comment"] },
    { "open": "'", "close": "'", "notIn": ["string", "comment"] }
  ],
  "surroundingPairs": [["(", ")"], ["\"", "\""], ["'", "'"]],
  "wordPattern": "[A-Za-z0-9][A-Za-z0-9-]*",
  "folding": {
    "markers": {
      "start": "^\\s*(TESTCASE|BEFORE-EACH|AFTER-EACH|MOCK)\\b",
      "end": "^\\s*(TESTCASE|END-BEFORE|END-AFTER|END-MOCK|IGNORE)\\b"
    }
  }
}
